{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OcuTrain",
  "version": "1.9.0",
  "identifier": "com.ocutrain.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-analysis.cjs",
    "beforeBuildCommand": "node scripts/prepare-analysis.cjs",
    "frontendDist": "../wwwroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OcuTrain",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main", "analysis"]
    }
  },
  "bundle": {
    "active": false
  }
}
